    USUARIOS {
        uuid id PK
        text correo UK
        text nombre_completo
        text telefono
        rol_usuario rol
        boolean correo_confirmado
        int intentos_fallidos
        timestamptz bloqueado_hasta
    }
    PERFILES_PRODUCTOR {
        uuid usuario_id PK, FK
        text nombre_taller
        text identificacion_oficial
        text comunidad
        text estado
        text pueblo_originario
        text tecnica_principal
        estado_verificacion estado_verificacion
    }
    VERIFICACIONES_PRODUCTOR {
        uuid id PK
        uuid productor_id FK
        uuid promotor_id FK
        estado_verificacion estado
        text observaciones
    }
    PERFILES_COMPRADOR {
        uuid usuario_id PK, FK
        text direccion_principal
        text nombre_empresa
        text rfc_empresa
    }
    PRODUCTOS {
        uuid id PK
        uuid productor_id FK
        text nombre
        text categoria
        numeric precio_unitario
        int stock
        boolean activo
    }
    FICHAS_ORIGEN {
        uuid id PK
        uuid producto_id FK, UK
        text nombre_productor
        text comunidad
        text estado
        text pueblo_originario
        text tecnica
        text materiales
        text tiempo_elaboracion
        numeric precio_registrado
        text_array fotografias_urls
    }
    SELLOS_ORIGINALIDAD {
        uuid id PK
        uuid ficha_origen_id FK, UK
        text folio_unico UK
        text firma_hmac
        boolean activo
    }
    PEDIDOS {
        uuid id PK
        text folio_pedido UK
        tipo_pedido tipo
        uuid comprador_id FK
        uuid productor_id FK
        estado_pedido estado
        numeric subtotal
        numeric monto_productor
        numeric monto_comision
        numeric total
    }
    DETALLES_PEDIDO {
        uuid id PK
        uuid pedido_id FK
        uuid producto_id FK
        int cantidad
        numeric precio_unitario
    }
    CONTRATOS_B2B {
        uuid id PK
        uuid pedido_id FK, UK
        text folio_contrato UK
        numeric monto_anticipo_30
        numeric monto_saldo_70
    }
    PAGOS {
        uuid id PK
        uuid pedido_id FK
        text tipo_cobro
        metodo_pago metodo
        numeric monto
        estado_pago estado
    }
    LIQUIDACIONES {
        uuid id PK
        uuid pedido_id FK, UK
        uuid productor_id FK
        numeric monto_bruto
        numeric porcentaje_comision
        numeric monto_neto_productor
    }
    SEGUIMIENTO_PEDIDOS {
        uuid id PK
        uuid pedido_id FK
        estado_pedido estado
        text nota
    }
    CALIFICACIONES {
        uuid id PK
        uuid pedido_id FK, UK
        uuid comprador_id FK
        uuid productor_id FK
        smallint puntuacion
    }
    BITACORA_AUDITORIA {
        bigserial id PK
        uuid usuario_id
        text accion
        text entidad
        text entidad_id
        jsonb valor_anterior
        jsonb valor_nuevo
    }
    NOTIFICACIONES {
        uuid id PK
        uuid usuario_id FK
        uuid pedido_id FK
        canal_notificacion canal
        text tipo
        text mensaje
        estado_notificacion estado
        timestamptz enviado_en
        timestamptz leido_en
    }
    REPORTES {
        uuid id PK
        uuid generado_por FK
        text tipo
        formato_reporte formato
        jsonb filtros
        date periodo_inicio
        date periodo_fin
        text url_archivo
        estado_reporte estado
    }
